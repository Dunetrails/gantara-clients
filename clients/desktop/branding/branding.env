# Gantara desktop-client branding — single source of truth.
#
# Sourced by apply-branding.sh, which rewrites a checked-out nextcloud/desktop
# tree in place. Also sourced by clients/install-appimage.sh, which needs
# APPLICATION_SHORTNAME to find the autostart entry the client writes.
#
# Every value here is either a name, an identifier or a URL. Nothing in this
# file changes what the client does — see ../README.md.

# Product name, as users see it: windows, tray, menus, .desktop Name=, the
# Windows installer and Start menu. Upstream's own branding switch
# (src/gui/CMakeLists.txt) keys off "is this still called Nextcloud?", and
# Theme::isBranded() does the same at runtime.
APPLICATION_NAME="Gantara"

# Everything below up to the URLs is identity, not display: settings directory,
# keychain service, autostart entry, CfApi sync roots, D-Bus names, executable.
# The client first shipped as Dunetrails, and renaming any of these orphans
# existing installs' accounts and sync folders. apply-branding.sh pins the
# lookups upstream derives from APPLICATION_NAME to APPLICATION_SHORTNAME.
APPLICATION_SHORTNAME="Dunetrails"
APPLICATION_EXECUTABLE="dunetrails"
APPLICATION_ICON_NAME="Dunetrails"
APPLICATION_DOMAIN="gantara.eu"
APPLICATION_VENDOR="Dunetrails"

# Reverse-DNS identity we register with the OS (.desktop id, D-Bus name).
# Must never be com.nextcloud.* — two clients claiming the same id collide.
APPLICATION_REV_DOMAIN="com.dunetrails.desktopclient"

# Basename of the Linux .desktop file and of the installed icon; combined with
# APPLICATION_REV_DOMAIN into LINUX_APPLICATION_ID.
LINUX_PACKAGE_SHORTNAME="dunetrails"

# Suffix of the placeholder files created in suffix-VFS mode: an online-only
# file shows up as <name>.dunetrails. Upstream ships "nextcloud", which would
# put the mark in every placeholder filename and in the MIME registration.
APPLICATION_VIRTUALFILE_SUFFIX="dunetrails"

# Links the client can hand the user. Upstream points these at nextcloud.com,
# docs.nextcloud.com and github.com/nextcloud.
BRAND_SITE_URL="https://gantara.eu"
BRAND_SIGNUP_URL="https://gantara.eu"
APPLICATION_HELP_URL="https://gantara.eu/support"

# Placeholder in the add-account wizard's server-address field (upstream:
# https://try.nextcloud.com). A hint only — the field stays editable, because
# tenants live on their own host.
APPLICATION_WIZARD_URL_HINT="https://gantara.eu"

# Updater endpoint. The AppImage is built with BUILD_UPDATER=OFF and this
# override pins it off in cmake as well, so nothing ever polls it. The value
# still has to be non-empty: theme.cpp dereferences the macro unconditionally
# and config.h only defines it when it is set. It points at our own domain so
# that a build with the updater accidentally re-enabled cannot reach
# updates.nextcloud.org, which serves the official, differently-branded client.
APPLICATION_UPDATE_URL="https://updates.gantara.eu/desktop/"

# House style. The wizard header comes from APPLICATION_WIZARD_HEADER_*; the
# default account accent colour comes from NEXTCLOUD_BACKGROUND_COLOR (upstream
# #0082c9), which Style.qml reads as its base colour.
BRAND_BACKGROUND_COLOR="#31469D"
BRAND_FONT_COLOR="#FFFFFF"

# Windows shell-extension + MSI UpgradeCode GUIDs.
# MUST be unique to this client — never reuse Nextcloud's. Regenerating them is a
# conflict-avoidance requirement (two products registering the same Explorer
# overlay CLSID collide), not a trademark one. Stable once committed; do not
# rotate casually or existing installs can't upgrade cleanly.
WIN_SHELLEXT_CONTEXT_MENU_GUID="{6E3B51EF-A42F-42B1-B273-61C5F9110C1F}"
WIN_SHELLEXT_OVERLAY_GUID_ERROR="{52E07161-8638-4DA3-ADF1-4CD87F74C825}"
WIN_SHELLEXT_OVERLAY_GUID_OK="{9EDE376C-2B76-42C4-8AA8-81E2BEB41F48}"
WIN_SHELLEXT_OVERLAY_GUID_OK_SHARED="{56BBADFD-66F2-41FF-85CA-CECE1547494E}"
WIN_SHELLEXT_OVERLAY_GUID_SYNC="{095FE947-5B7C-4D7D-B4EC-7C35537274AA}"
WIN_SHELLEXT_OVERLAY_GUID_WARNING="{6B51A498-DE8F-4EF7-9CCD-7EB98D22C80A}"
# MSI Upgrade Code (without brackets — matches upstream NEXTCLOUD.cmake shape).
WIN_MSI_UPGRADE_CODE="B01A9169-366C-4736-AF5B-F39023B60FB7"

# CfApi (Windows virtual-files) shell-extension class IDs. Hardcoded in upstream
# CMakeLists.txt AFTER NEXTCLOUD.cmake is included, so apply-branding.sh rewrites
# them in place rather than appending to NEXTCLOUD.cmake.
CFAPI_SHELLEXT_APPID_REG="{40343B5A-1A85-410E-A110-B491A4D16A11}"
CFAPI_SHELLEXT_CUSTOM_STATE_HANDLER_CLASS_ID="50D41704-5FFD-4F93-BBBB-9233809A673A"
CFAPI_SHELLEXT_THUMBNAIL_HANDLER_CLASS_ID="08F5A8DB-4135-4AE7-8ED8-A74789132C39"
